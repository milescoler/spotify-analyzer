# Word Garden — optional configuration.
# Copy to ".env" and fill in to enable AI-generated learning content.
# The app runs fine WITHOUT this (it stores labeled sample content instead).

# Your Anthropic API key — enables Claude to write definitions, examples, and
# interest-personalized scenarios. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: which Claude model to use (default: claude-opus-4-8).
# For a large class you may prefer a faster/cheaper tier:
#   claude-haiku-4-5   or   claude-sonnet-4-6
# WORD_GARDEN_MODEL=claude-opus-4-8
